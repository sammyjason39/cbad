# Qwen (Alibaba Cloud MaaS) — configured on n8n instance for the CBAD backend workflow
QWEN_API_KEY=your-api-key-here
QWEN_API_BASE=https://ws-pvflth6kss1o2my2.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# CBAD app → n8n backend (default: enabled; set N8N_BACKEND=false to call Qwen directly)
N8N_HOST=https://n8n.indonesiabelajarai.com
N8N_WEBHOOK_HEALTH=a8f3c2d1-5e4b-4a9c-8d1e-2f6b9c0a1d2e
N8N_WEBHOOK_CHAT=b9e4d3c2-6f5a-4b0d-9e2f-3a7c8d9e0f1b
# N8N_BACKEND=false
